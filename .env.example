# Environment Configuration Example
# Copy this file to .env and update with your values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL password (must match appsettings.json for local dev)
POSTGRES_PASSWORD=Bilal

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
# Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Production

# JWT Secret Key (minimum 32 characters)
# IMPORTANT:
# - For local development: Use the value from appsettings.json
# - For production: Generate a NEW random secret (see below)
# Current development value from appsettings.json:
JWT_SECRET=YourSuperSecretKeyThatIsAtLeast32CharactersLongForSecurity!

# ===========================================
# OPTIONAL: OpenAI API (for ChatGPT features)
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here


# ===========================================
# HOW TO GENERATE A SECURE JWT SECRET
# ===========================================
#
# Method 1: Using PowerShell (Windows)
# -------------------------------------
# -Add-Type -AssemblyName System.Web
# [System.Web.Security.Membership]::GeneratePassword(64, 10)
#
# Method 2: Using OpenSSL (Linux/Mac/Git Bash)
# ---------------------------------------------
# openssl rand -base64 64
#
# Method 3: Using Node.js
# -----------------------
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#
# Method 4: Using online tool
# ---------------------------
# https://generate-secret.vercel.app/64
#
# Example generated secret:
# JWT_SECRET=Xy7mK9pQ2wR5tY8uI1oP3aS6dF4gH7jK0lZ9xC8vB5nM2qW6eR4tY7uI1oP3aS5dF8gH
#
